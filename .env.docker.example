# Development works without this file. Production requires POSTGRES_PASSWORD.
DEV_PORT=3000
PROD_PORT=3000
PROD_BIND=127.0.0.1
RADIO_CALICO_IMAGE=radio-calico
POSTGRES_DB=radiocalico
POSTGRES_USER=radiocalico
# Set a long random password in your private .env.docker before starting Production.
POSTGRES_PASSWORD=
